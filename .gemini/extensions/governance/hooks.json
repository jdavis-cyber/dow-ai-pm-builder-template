{
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "bash governance/hooks/session_start.sh" } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "bash governance/hooks/user_prompt.sh" } ] }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|WriteFile|Shell|run_shell_command",
        "hooks": [ { "type": "command", "command": "bash governance/hooks/pretooluse.sh gemini" } ]
      }
    ]
  }
}
